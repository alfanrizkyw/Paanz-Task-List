AUTH_SECRET=generate-a-random-secret-at-least-32-characters
SPADA_BASE_URL=https://slc.polinema.ac.id/spada/
MOODLE_BASE_URL=https://lmsslc.polinema.ac.id
# Vercel membuat BLOB_STORE_ID otomatis saat Blob dihubungkan ke project.
# Runtime Vercel menyediakan OIDC; tidak ada token yang perlu disimpan di repo.
# Untuk hosting non-Vercel, ambil token dari panel Blob tanpa meng-commit nilainya.
# BLOB_READ_WRITE_TOKEN=
# Opsional untuk server non-Vercel tanpa Chrome atau Edge bawaan.
# CHROME_PATH=/path/to/chrome
